{
  "name": "math-tutor-webapp",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start-dev": "ng serve --port 4400 --open -c start-dev --host 0.0.0.0 --disable-host-check ci",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "ci:generate-math-tutor-swagger": "npx @openapitools/openapi-generator-cli generate -g typescript-angular -i http://127.0.0.1:8000/openapi.json -o src/app/shared/swagger/math-tutor --skip-validate-spec --global-property=models,supportingFiles"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@primeuix/themes": "^2.0.3",
    "@tailwindcss/postcss": "^4.2.1",
    "mathlive": "^0.109.0",
    "postcss": "^8.5.8",
    "primeng": "^21.1.3",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.2.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.2",
    "@angular/cli": "^21.2.2",
    "@angular/compiler-cli": "^21.2.0",
    "@types/node": "^25.5.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
